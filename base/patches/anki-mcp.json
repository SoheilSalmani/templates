{
  "title": "Anki MCP server",
  "description": "Declares the anki MCP server whose tools anki-flashcards calls, @ankimcp/anki-mcp-server 0.26.0 run by npx over stdio, for Claude Code, Codex and oh-my-pi. It talks to AnkiConnect at its default http://localhost:8765, so the entry is the same on every machine and holds no credential.",
  "depends_on": [
    "mcp"
  ],
  "when": "use_anki",
  "ops": [
    {
      "op": "fill_slot",
      "path": ".codex/config.toml",
      "slot": "entries",
      "key": "anki-mcp",
      "lines": [
        "anki = { command = \"npx\", args = [\"-y\", \"@ankimcp/anki-mcp-server@0.26.0\", \"--stdio\"] }"
      ]
    },
    {
      "op": "fill_slot",
      "path": ".mcp.json",
      "slot": "entries",
      "key": "anki-mcp",
      "lines": [
        "    \"anki\": { \"type\": \"stdio\", \"command\": \"npx\", \"args\": [\"-y\", \"@ankimcp/anki-mcp-server@0.26.0\", \"--stdio\"] }"
      ]
    },
    {
      "op": "fill_slot",
      "path": ".omp/mcp.json",
      "slot": "entries",
      "key": "anki-mcp",
      "lines": [
        "    \"anki\": { \"type\": \"stdio\", \"command\": \"npx\", \"args\": [\"-y\", \"@ankimcp/anki-mcp-server@0.26.0\", \"--stdio\"] }"
      ]
    }
  ]
}
