{
  "title": "MCP connections",
  "description": "Holds the lines .mcp.json (Claude Code), .codex/config.toml (Codex) and .omp/mcp.json (oh-my-pi) share around the slot each MCP server's patch fills, and leaves a file out while no server fills it. Written by weft share from linear-mcp and jira-mcp; change it with weft patch amend.",
  "ops": [
    {
      "op": "create_file",
      "path": ".mcp.json",
      "omit_when_empty": [
        "entries"
      ],
      "content": [
        "{",
        "  \"mcpServers\": {",
        {
          "slot": "entries",
          "separator": ","
        },
        "  }",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": ".codex/config.toml",
      "omit_when_empty": [
        "entries"
      ],
      "content": [
        "# Project-scoped Codex configuration. Codex reads it only after `codex` has marked this project as trusted.",
        "",
        "[mcp_servers]",
        {
          "slot": "entries"
        }
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": ".omp/mcp.json",
      "omit_when_empty": [
        "entries"
      ],
      "content": [
        "{",
        "  \"$schema\": \"https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json\",",
        "  \"mcpServers\": {",
        {
          "slot": "entries",
          "separator": ","
        },
        "  }",
        "}"
      ],
      "mode": 420
    }
  ]
}
