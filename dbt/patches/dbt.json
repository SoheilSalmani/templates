{
  "title": "dbt project",
  "description": "Adds dbt_project.yml with dbt_utils in packages.yml, a uv-managed pyproject.toml pinned to Python 3.13, the empty models, macros and seeds directories, and the dbt VS Code extension recommendation on top of base, whose README the project keeps. The dbt and Python stanzas go at the top of base's .gitignore, and the uv-sync and dbt-deps hooks run before base's git-commit.",
  "depends_on": [
    "base"
  ],
  "ops": [
    {
      "op": "modify_file",
      "path": ".gitignore",
      "hunks": [
        {
          "context_before": [],
          "removed": [],
          "added": [
            "# Compiled files (dbt)",
            "target/",
            "",
            "# Internal packages (dbt)",
            "dbt_internal_packages/",
            "",
            "# Logs (dbt)",
            "logs/",
            "",
            "# Third-party packages (dbt)",
            "dbt_packages/",
            "",
            "# Cache folders (Python)",
            "__pycache__/",
            "",
            "# Virtual environments (Python)",
            ".venv/",
            "",
            "# Configuration and data (Rope)",
            ".ropeproject/",
            ""
          ],
          "context_after": [
            "# Operating system",
            ".DS_Store"
          ]
        }
      ]
    },
    {
      "op": "create_file",
      "path": ".python-version",
      "content": [
        "3.13"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": ".vscode/extensions.json",
      "content": [
        "{",
        "  \"recommendations\": [",
        "    \"dbtLabsInc.dbt\"",
        "  ]",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "dbt_project.yml",
      "content": [
        [
          "name: ",
          {
            "answer": "package_name"
          }
        ],
        "",
        [
          "profile: ",
          {
            "answer": "profile_name"
          }
        ],
        "",
        "seed-paths: [\"seeds\"]",
        "model-paths: [\"models\"]",
        "macro-paths: [\"macros\"]",
        "clean-targets:",
        "  - \"target\"",
        "  - \"dbt_packages\"",
        "",
        "seeds:",
        "  # Builds seeds into '<your_schema_name>_raw'",
        [
          "  ",
          {
            "answer": "package_name"
          },
          ":"
        ],
        "    +schema: raw",
        "",
        "models:",
        [
          "  ",
          {
            "answer": "package_name"
          },
          ":"
        ],
        "    +static_analysis: strict",
        "    # Materialize staging models as views, and marts as tables",
        "    staging:",
        "      +materialized: view",
        "    marts:",
        "      +materialized: table"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "macros/.gitkeep",
      "content": [],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "models/.gitkeep",
      "content": [],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "packages.yml",
      "content": [
        "packages:",
        "  - package: dbt-labs/dbt_utils",
        "    version: \">=1.3.0\""
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "pyproject.toml",
      "content": [
        "[project]",
        [
          "name = \"",
          {
            "answer": "package_name"
          },
          "\""
        ],
        "version = \"0.1.0\"",
        "description = \"Add your description here\"",
        "requires-python = \">=3.13\"",
        "dependencies = [\"dbt>=2.0.0rc202\"]"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "seeds/.gitkeep",
      "content": [],
      "mode": 420
    }
  ],
  "hooks": [
    {
      "id": "verify-uv",
      "phase": "pre",
      "effect": "check",
      "label": "Verify uv is installed",
      "action": "command -v uv"
    },
    {
      "id": "uv-sync",
      "phase": "post",
      "effect": "setup",
      "label": "Lock and sync the Python environment",
      "action": "uv lock && uv sync",
      "after": [
        "mise-install"
      ],
      "before": [
        "git-commit"
      ],
      "inputs": [
        "glob:pyproject.toml"
      ]
    },
    {
      "id": "dbt-deps",
      "phase": "post",
      "effect": "setup",
      "label": "Install dbt packages",
      "action": "uv run dbt deps",
      "after": [
        "uv-sync"
      ],
      "before": [
        "git-commit"
      ],
      "inputs": [
        "glob:packages.yml"
      ]
    }
  ]
}
