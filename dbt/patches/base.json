{
  "title": "dbt project",
  "description": "Adds dbt_project.yml with dbt_utils in packages.yml, a uv-managed pyproject.toml pinned to Python 3.13, the empty models, macros and seeds directories, the dbt VS Code extension recommendation, and the stack .gitignore.",
  "ops": [
    {
      "op": "create_file",
      "path": ".gitignore",
      "content": [
        "# Compiled files (dbt)",
        "target/",
        "",
        "# Internal packages (dbt)",
        "dbt_internal_packages/",
        "",
        "# Logs (dbt)",
        "logs/",
        "",
        "# Third-party packages (dbt)",
        "dbt_packages/",
        "",
        "# Cache folders (Python)",
        "__pycache__/",
        "",
        "# Virtual environments (Python)",
        ".venv/",
        "",
        "# Configuration and data (Rope)",
        ".ropeproject/",
        "",
        "# Operating system",
        ".DS_Store",
        "Thumbs.db",
        "",
        "# Environment files",
        ".env",
        ".env.*",
        "!.env.example",
        "",
        "# Personal toolchain overrides (mise)",
        "mise.local.toml",
        "",
        "# Personal settings (Claude Code)",
        ".claude/settings.local.json"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": ".python-version",
      "content": [
        "3.13"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": ".vscode/extensions.json",
      "content": [
        "{",
        "  \"recommendations\": [",
        "    \"dbtLabsInc.dbt\"",
        "  ]",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "dbt_project.yml",
      "content": [
        [
          "name: ",
          {
            "answer": "package_name"
          }
        ],
        "",
        [
          "profile: ",
          {
            "answer": "profile_name"
          }
        ],
        "",
        "seed-paths: [\"seeds\"]",
        "model-paths: [\"models\"]",
        "macro-paths: [\"macros\"]",
        "clean-targets:",
        "  - \"target\"",
        "  - \"dbt_packages\"",
        "",
        "seeds:",
        "  # Builds seeds into '<your_schema_name>_raw'",
        [
          "  ",
          {
            "answer": "package_name"
          },
          ":"
        ],
        "    +schema: raw",
        "",
        "models:",
        [
          "  ",
          {
            "answer": "package_name"
          },
          ":"
        ],
        "    +static_analysis: strict",
        "    # Materialize staging models as views, and marts as tables",
        "    staging:",
        "      +materialized: view",
        "    marts:",
        "      +materialized: table"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "macros/.gitkeep",
      "content": [],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "models/.gitkeep",
      "content": [],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "packages.yml",
      "content": [
        "packages:",
        "  - package: dbt-labs/dbt_utils",
        "    version: \">=1.3.0\""
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "pyproject.toml",
      "content": [
        "[project]",
        [
          "name = \"",
          {
            "answer": "package_name"
          },
          "\""
        ],
        "version = \"0.1.0\"",
        "description = \"Add your description here\"",
        "requires-python = \">=3.13\"",
        "dependencies = [\"dbt>=2.0.0rc202\"]"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "seeds/.gitkeep",
      "content": [],
      "mode": 420
    }
  ],
  "hooks": [
    {
      "id": "verify-uv",
      "phase": "pre",
      "effect": "check",
      "label": "Verify uv is installed",
      "action": "command -v uv"
    },
    {
      "id": "git-init",
      "phase": "post",
      "effect": "setup",
      "label": "Initialise the git repository",
      "action": "git init -q -b main"
    },
    {
      "id": "uv-sync",
      "phase": "post",
      "effect": "setup",
      "label": "Lock and sync the Python environment",
      "action": "uv lock && uv sync",
      "after": [
        "mise-install"
      ],
      "inputs": [
        "glob:pyproject.toml"
      ]
    },
    {
      "id": "dbt-deps",
      "phase": "post",
      "effect": "setup",
      "label": "Install dbt packages",
      "action": "uv run dbt deps",
      "after": [
        "uv-sync"
      ],
      "inputs": [
        "glob:packages.yml"
      ]
    },
    {
      "id": "git-commit",
      "phase": "post",
      "effect": "setup",
      "label": "Commit the scaffold",
      "description": "First commit after every setup hook that may exist has run.",
      "action": "git add -A && git commit -q -m 'Scaffold repository'",
      "after": [
        "git-init",
        "mise-install",
        "sync-claude-skills",
        "uv-sync",
        "dbt-deps"
      ]
    }
  ]
}
