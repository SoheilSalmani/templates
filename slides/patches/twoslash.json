      "op": "create_file",
      "path": "plugins/twoslash.ts",
      "content": [
        "import path from \"node:path\"",
        "import {",
        "  createTransformerFactory,",
        "  defaultHoverInfoProcessor,",
        "  type TwoslashRenderer,",
        "  type TwoslashShikiReturn,",
        "} from \"@shikijs/twoslash/core\"",
        "import type { Element, Properties, Text } from \"hast\"",
        "import type { ShikiTransformer } from \"shiki\"",
        "import {",
        "  TwoslashError,",
        "  createTwoslasher,",
        "  type TwoslashInstance,",
        "} from \"twoslash/core\"",
        "import type { CodeToken, LineNote } from \"../src/code/types.ts\"",
        "",
        "/** Fence languages Twoslash can check. */",
        "export const twoslashLangs = [\"ts\", \"tsx\", \"js\", \"jsx\"]",
        "",
        "/**",
        " * One Twoslash instance for the whole dev server, made when the first block",
        " * asks for it, since importing TypeScript alone takes a few hundred",
        " * milliseconds. It builds a language service on the first block (about half",
        " * a second) and one more for each distinct set of `// @flag` lines; after",
        " * that a block takes 5–40 ms.",
        " */",
        "let twoslasher: Promise<TwoslashInstance> | undefined",
        "",
        "/**",
        " * Results by block, for the life of the dev server: saving slides.mdx",
        " * recompiles every block, and the unchanged ones then skip TypeScript. Like",
        " * the language service, this does not notice edits to the files a block",
        " * imports; restart the dev server (`r`) after changing them.",
        " */",
        "const results = new Map<string, TwoslashShikiReturn>()",
        "",
        "/** Wraps a token's text in a span that carries only data properties. */",
        "function mark(node: Element | Text, properties: Properties): Element {",
        "  return { type: \"element\", tagName: \"span\", properties, children: [node] }",
        "}",
        "",
        "/** A sibling of the line elements, which `noteOf` turns into a line note. */",
        "function note(properties: Properties): Element {",
        "  return { type: \"element\", tagName: \"div\", properties, children: [] }",
        "}",
        "",
        "/**",
        " * The first paragraph of a JSDoc comment. Twoslash joins the comment's",
        " * parts with newlines, so `{@link X}` arrives as `{@link \\nX\\n}`.",
        " */",
        "function summary(docs: string | undefined) {",
        "  return docs",
        "    ?.split(/\\n\\s*\\n/)[0]",
        "    ?.replace(/\\{@link(?:code|plain)?\\s+([^}]*?)\\s*\\}/g, \"$1\")",
        "    .replace(/\\s+/g, \" \")",
        "    .trim()",
        "}",
        "",
        "/**",
        " * Adds no markup of its own: each hook returns a bare element whose data",
        " * properties hold what Twoslash found, which `tokenInfo` and `noteOf` read",
        " * back. HAST property names are camelCase: `dataHover` is `data-hover`.",
        " */",
        "const renderer: TwoslashRenderer = {",
        "  nodeStaticInfo(info, node) {",
        "    return mark(node, {",
        "      dataHover: defaultHoverInfoProcessor(info.text),",
        "      dataDocs: summary(info.docs),",
        "    })",
        "  },",
        "  nodeQuery(query, node) {",
        "    return mark(node, {",
        "      dataHover: defaultHoverInfoProcessor(query.text),",
        "      dataDocs: summary(query.docs),",
        "    })",
        "  },",
        "  nodeError(error, node) {",
        "    return mark(node, { dataError: error.text })",
        "  },",
        "  lineQuery(query) {",
        "    return [",
        "      note({",
        "        dataNote: \"query\",",
        "        dataCharacter: query.character,",
        "        dataText: defaultHoverInfoProcessor(query.text),",
        "      }),",
        "    ]",
        "  },",
        "  lineError(error) {",
        "    return [",
        "      note({",
        "        dataNote: \"error\",",
        "        dataCharacter: error.character,",
        "        dataText: error.text,",
        "        dataCode: error.code,",
        "      }),",
        "    ]",
        "  },",
        "  lineCompletion(completion) {",
        "    return [",
        "      note({",
        "        dataNote: \"completion\",",
        "        dataCharacter: completion.character,",
        "        dataPrefix: completion.completionsPrefix,",
        "        dataItems: completion.completions.map((item) => item.name).join(\"\\n\"),",
        "      }),",
        "    ]",
        "  },",
        "  lineCustomTag(tag) {",
        "    return [note({ dataNote: \"tag\", dataName: tag.name, dataText: tag.text })]",
        "  },",
        "}",
        "",
        "/**",
        " * The Twoslash transformer for a block. Creating it is cheap; the",
        " * TypeScript work is shared. `fail` is for a block Twoslash rejects (an",
        " * error the block does not expect with `// @errors`, a `^?` that points at",
        " * nothing), `warn` for a result it could not place on the tokens.",
        " */",
        "export async function transformerTwoslash(",
        "  fail: (reason: string) => never,",
        "  warn: (reason: string) => void",
        "): Promise<ShikiTransformer> {",
        "  // Imported here, not at the top: Vite bundles this file into the config,",
        "  // and a static import would load TypeScript on every start.",
        "  twoslasher ??= import(\"typescript\").then(({ default: ts }) =>",
        "    createTwoslasher({",
        "      tsModule: ts,",
        "      // A block is a virtual `index.ts` at the project root, so its imports",
        "      // resolve like the deck's own code: packages from node_modules,",
        "      // `./src/…` and `@/…` from the project. No tsconfig is read; these",
        "      // options are all a block gets, plus its own `// @flag` lines.",
        "      vfsRoot: path.resolve(import.meta.dirname, \"..\"),",
        "      compilerOptions: {",
        "        moduleResolution: ts.ModuleResolutionKind.Bundler,",
        "        jsx: ts.JsxEmit.ReactJSX,",
        "        allowImportingTsExtensions: true,",
        "        noEmit: true,",
        "        paths: { \"@/*\": [\"./src/*\"] },",
        "      },",
        "    })",
        "  )",
        "  return createTransformerFactory(",
        "    await twoslasher,",
        "    renderer",
        "  )({",
        "    langs: twoslashLangs,",
        "    typesCache: {",
        "      read: (code, lang) => results.get(`${lang}:${code}`) ?? null,",
        "      write: (code, data, lang) => void results.set(`${lang}:${code}`, data),",
        "    },",
        "    onTwoslashError(error) {",
        "      fail(",
        "        error instanceof TwoslashError",
        "          ? `twoslash: ${error.title}. ${error.description.trim()}`",
        "          : `twoslash: ${error instanceof Error ? error.message : error}`",
        "      )",
        "    },",
        "    onShikiError(error) {",
        "      warn(`twoslash: ${error instanceof Error ? error.message : error}`)",
        "    },",
        "  })",
        "}",
        "",
        "/** What Twoslash put on a token's element: its type, docs or error. */",
        "export function tokenInfo(",
        "  properties: Properties",
        "): Pick<CodeToken, \"hover\" | \"docs\" | \"error\"> {",
        "  const { dataHover, dataDocs, dataError } = properties",
        "  return {",
        "    ...(dataHover !== undefined && { hover: String(dataHover) }),",
        "    ...(dataDocs !== undefined && { docs: String(dataDocs) }),",
        "    ...(dataError !== undefined && { error: String(dataError) }),",
        "  }",
        "}",
        "",
        "/** A note element from the renderer above, as data; none for a line. */",
        "export function noteOf({ properties: p }: Element): LineNote | undefined {",
        "  const character = Number(p.dataCharacter) || 0",
        "  switch (p.dataNote) {",
        "    case \"query\":",
        "      return { kind: \"query\", character, text: String(p.dataText) }",
        "    case \"error\":",
        "      return {",
        "        kind: \"error\",",
        "        character,",
        "        text: String(p.dataText),",
        "        ...(p.dataCode !== undefined && { code: String(p.dataCode) }),",
        "      }",
        "    case \"completion\":",
        "      return {",
        "        kind: \"completion\",",
        "        character,",
        "        prefix: String(p.dataPrefix),",
        "        items: String(p.dataItems).split(\"\\n\"),",
        "      }",
        "    case \"tag\":",
        "      return {",
        "        kind: \"tag\",",
        "        name: String(p.dataName),",
        "        ...(p.dataText !== undefined && { text: String(p.dataText) }),",
        "      }",
        "  }",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "src/code/twoslash.css",
      "content": [
        "/* Twoslash: types on hover and notes under lines, from plugins/twoslash.ts. */",
        "",
        ".code-info {",
        "  border-radius: 0.2em;",
        "  cursor: help;",
        "}",
        "",
        ".code-info:hover {",
        "  background-color: var(--code-highlight);",
        "}",
        "",
        "/* On the wrapper, since the token's own text-decoration comes from Shiki. */",
        ".code-info[data-error] {",
        "  text-decoration: underline wavy var(--destructive);",
        "  text-decoration-skip-ink: none;",
        "  text-underline-offset: 0.25em;",
        "}",
        "",
        "/* A note never widens the block: it wraps at the width of the code. */",
        ".code-note {",
        "  contain: inline-size;",
        "}",
        "",
        ".code-note .code-line-content {",
        "  white-space: pre-wrap;",
        "}",
        "",
        ".code-note-box {",
        "  position: relative;",
        "  display: inline-block;",
        "  margin-block: 0.3em 0.45em;",
        "  padding: 0.05em 0.6em;",
        "  border: 1px solid color-mix(in oklch, var(--foreground) 22%, transparent);",
        "  border-radius: 0.375em;",
        "  background-color: var(--popover);",
        "  color: var(--popover-foreground);",
        "}",
        "",
        "/* A query points up at the token it asks about. */",
        ".code-note[data-note=\"query\"] .code-note-box::before {",
        "  content: \"\";",
        "  position: absolute;",
        "  top: -0.36em;",
        "  left: 0.6em;",
        "  width: 0.65em;",
        "  height: 0.65em;",
        "  border-top: inherit;",
        "  border-left: inherit;",
        "  background-color: inherit;",
        "  transform: rotate(45deg);",
        "}",
        "",
        ".code-note[data-note=\"error\"] .code-note-box {",
        "  border-color: color-mix(in oklch, var(--destructive) 60%, transparent);",
        "  background-color: color-mix(",
        "    in oklch,",
        "    var(--destructive) 12%,",
        "    var(--background)",
        "  );",
        "}",
        "",
        ".code-note-label {",
        "  color: var(--muted-foreground);",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "src/code/twoslash.tsx",
      "content": [
        "import type { ReactElement } from \"react\"",
        "import {",
        "  Tooltip,",
        "  TooltipContent,",
        "  TooltipTrigger,",
        "} from \"@/components/ui/tooltip\"",
        "import type { CodeToken, LineNote } from \"./types\"",
        "import \"./twoslash.css\"",
        "",
        "/**",
        " * A token Twoslash knows the type of, or found an error in: hovering it",
        " * shows the type and its documentation, or the error.",
        " */",
        "export function TokenInfo({",
        "  token,",
        "  children,",
        "}: {",
        "  token: CodeToken",
        "  children: ReactElement",
        "}) {",
        "  return (",
        "    <Tooltip>",
        "      <TooltipTrigger asChild>",
        "        <span className=\"code-info\" data-error={token.error ? \"\" : undefined}>",
        "          {children}",
        "        </span>",
        "      </TooltipTrigger>",
        "      <TooltipContent",
        "        side=\"bottom\"",
        "        align=\"start\"",
        "        className=\"max-w-lg flex-col items-start gap-1 font-mono text-[13px] leading-snug\"",
        "      >",
        "        <span className=\"whitespace-pre-wrap\">",
        "          {token.error ?? token.hover}",
        "        </span>",
        "        {token.docs && !token.error && (",
        "          <span className=\"font-sans opacity-80\">{token.docs}</span>",
        "        )}",
        "      </TooltipContent>",
        "    </Tooltip>",
        "  )",
        "}",
        "",
        "/**",
        " * Twoslash's notes under a line: the type a `// ^?` asks for, an expected",
        " * error, completions and `@log` tags. Unlike hovers they are always shown,",
        " * in print too, and they dim with their line.",
        " */",
        "export function LineNotes({",
        "  notes,",
        "  lineNumbers,",
        "  diff,",
        "  dim,",
        "}: {",
        "  notes: LineNote[]",
        "  lineNumbers: boolean",
        "  diff: boolean",
        "  dim: boolean",
        "}) {",
        "  return notes.map((note, i) => (",
        "    <span",
        "      key={i}",
        "      className=\"code-line code-note\"",
        "      data-note={note.kind}",
        "      data-dim={dim || undefined}",
        "    >",
        "      {lineNumbers && <span className=\"code-line-number\" />}",
        "      {diff && <span className=\"code-diff-sign\" />}",
        "      <span",
        "        className=\"code-line-content\"",
        "        style={{",
        "          paddingInlineStart: `${\"character\" in note ? note.character : 0}ch`,",
        "        }}",
        "      >",
        "        <span className=\"code-note-box\">",
        "          <NoteText note={note} />",
        "        </span>",
        "      </span>",
        "    </span>",
        "  ))",
        "}",
        "",
        "function NoteText({ note }: { note: LineNote }) {",
        "  switch (note.kind) {",
        "    case \"query\":",
        "      return note.text",
        "    case \"error\":",
        "      return (",
        "        <>",
        "          {note.text}",
        "          {note.code && <span className=\"code-note-label\"> {note.code}</span>}",
        "        </>",
        "      )",
        "    case \"completion\":",
        "      return note.items.slice(0, 6).map((item) => (",
        "        <span key={item} className=\"block\">",
        "          <b>{item.slice(0, note.prefix.length)}</b>",
        "          {item.slice(note.prefix.length)}",
        "        </span>",
        "      ))",
        "    case \"tag\":",
        "      return (",
        "        <>",
        "          <span className=\"code-note-label\">{note.name}</span> {note.text}",
        "        </>",
        "      )",
        "  }",
        "}"
      ],
      "mode": 420
    }
  ]
}
