{
  "title": "Twoslash types in code",
  "description": "Adds twoslash to code fences: TypeScript runs on the block when the deck builds, hovering a name shows its type and documentation, // ^? pins a type under the line, and // @errors shows an error the code is meant to have, while any other error stops the build. One Twoslash instance and a results cache keep saves fast; the README and the writing-slides skill document it.",
  "depends_on": [
    "export",
    "writing-slides"
  ],
  "when": "use_twoslash",
