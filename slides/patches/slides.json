    {
      "op": "create_file",
      "path": "tsconfig.node.json",
      "content": [
        "{",
        "  \"compilerOptions\": {",
        "    \"tsBuildInfoFile\": \"./node_modules/.tmp/tsconfig.node.tsbuildinfo\",",
        "    \"target\": \"es2023\",",
        "    \"lib\": [\"ES2023\"],",
        "    \"module\": \"esnext\",",
        "    \"types\": [\"node\"],",
        "    \"skipLibCheck\": true,",
        "",
        "    /* Bundler mode */",
        "    \"moduleResolution\": \"bundler\",",
        "    \"allowImportingTsExtensions\": true,",
        "    \"verbatimModuleSyntax\": true,",
        "    \"moduleDetection\": \"force\",",
        "    \"noEmit\": true,",
        "",
        "    /* Linting */",
        "    \"strict\": true,",
        "    \"noUnusedLocals\": true,",
        "    \"noUnusedParameters\": true,",
        "    \"erasableSyntaxOnly\": true,",
        "    \"noFallthroughCasesInSwitch\": true",
        "  },",
        "  \"include\": [\"vite.config.ts\"]",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "vite.config.ts",
      "content": [
        "import path from \"node:path\"",
        "import tailwindcss from \"@tailwindcss/vite\"",
        "import react from \"@vitejs/plugin-react\"",
        "import { defineConfig } from \"vite\"",
        "",
        "export default defineConfig({",
        "  // Relative asset URLs, so the build runs from any path or static host.",
        "  base: \"./\",",
        "  plugins: [react(), tailwindcss()],",
        "  resolve: {",
        "    alias: {",
        "      \"@\": path.resolve(import.meta.dirname, \"src\"),",
        "    },",
        "  },",
        "})"
      ],
      "mode": 420
    }
  ],
  "hooks": [
    {
      "id": "verify-pnpm",
      "phase": "pre",
      "effect": "check",
      "label": "Verify pnpm is installed",
      "action": "command -v pnpm"
    },
    {
      "id": "pnpm-install",
      "phase": "post",
      "effect": "setup",
      "label": "Install dependencies",
      "description": "Installs what package.json lists and writes pnpm-lock.yaml. Idempotent; re-runs when package.json changes.",
      "action": "pnpm install",
      "after": [
        "mise-install"
      ],
      "before": [
        "git-commit"
      ],
      "inputs": [
        "glob:package.json"
      ]
    }
  ]
}
