{
  "title": "GitHub Pages deploy",
  "description": "Adds a GitHub Actions workflow that builds the deck and deploys it to GitHub Pages on every push to main; the build uses relative paths and hash routes, so it works under the repository's sub-path as it is.",
  "depends_on": [
    "export"
  ],
  "when": "use_github_pages",
  "ops": [
    {
      "op": "create_file",
      "path": ".github/workflows/pages.yml",
      "content": [
        "name: Pages",
        "",
        "# Publishes the deck on every push to main. Set the repository's",
        "# Settings → Pages → Source to \"GitHub Actions\" once, first.",
        "on:",
        "  push:",
        "    branches: [main]",
        "  workflow_dispatch:",
        "",
        "permissions:",
        "  contents: read",
        "  pages: write",
        "  id-token: write",
        "",
        "# One deployment at a time, and never cancel one that has started.",
        "concurrency:",
        "  group: pages",
        "  cancel-in-progress: false",
        "",
        "jobs:",
        "  build:",
        "    runs-on: ubuntu-latest",
        "    steps:",
        "      - uses: actions/checkout@v7",
        "      - uses: jdx/mise-action@v4",
        "      - name: Locate the pnpm store",
        "        id: pnpm-store",
        "        run: echo \"path=$(pnpm store path)\" >> \"$GITHUB_OUTPUT\"",
        "      - uses: actions/cache@v6",
        "        with:",
        "          path: ${{ steps.pnpm-store.outputs.path }}",
        "          key: pnpm-store-${{ runner.os }}-${{ hashFiles('pnpm-lock.yaml') }}",
        "          restore-keys: pnpm-store-${{ runner.os }}-",
        "      - run: pnpm install --frozen-lockfile",
        "      # The build uses relative paths and hash routes, so it works under",
        "      # https://<owner>.github.io/<repository>/ as it is.",
        "      - run: pnpm build",
        "      - uses: actions/configure-pages@v6",
        "      - uses: actions/upload-pages-artifact@v5",
        "        with:",
        "          path: dist/",
        "",
        "  deploy:",
        "    needs: build",
        "    runs-on: ubuntu-latest",
        "    environment:",
        "      name: github-pages",
        "      url: ${{ steps.deployment.outputs.page_url }}",
        "    steps:",
        "      - id: deployment",
        "        uses: actions/deploy-pages@v5"
      ],
      "mode": 420
    }
  ]
}
