      "op": "create_file",
      "path": "mdx-env.d.ts",
      "content": [
        "// Types for the deck's .mdx files, read by the MDX editor extension and by",
        "// `pnpm typecheck` through tsconfig.mdx.json. The app does not see them.",
        "import type { Notes, Slide } from \"./src/deck/slide\"",
        "import type { components } from \"./src/mdx-components\"",
        "",
        "declare global {",
        "  /** What a slide can use without importing it. */",
        "  type MDXProvidedComponents = typeof components & {",
        "    Slide: typeof Slide",
        "    Notes: typeof Notes",
        "    /** Replaced by the file it names at build time (plugins/remark-include.ts). */",
        "    Include: (props: { src: string }) => null",
        "  }",
        "",
        "  /**",
        "   * `<motion.div>` takes `motion` from the components at run time, but the",
        "   * MDX language service looks it up as a variable; this makes it one.",
        "   */",
        "  const motion: MDXProvidedComponents[\"motion\"]",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "scripts/typecheck.ts",
      "content": [
        "// `tsc`, plus the .mdx files, checked by the MDX language service that the",
        "// VS Code MDX extension runs. Arguments go to tsc unchanged, so",
        "// `node scripts/typecheck.ts -b` checks every project, slides.mdx included.",
        "// A tsconfig's `mdx` section (checkMdx, plugins) applies here as it does in",
        "// the editor.",
        "import { createRequire } from \"node:module\"",
        "import {",
        "  createMdxLanguagePlugin,",
        "  resolvePlugins,",
        "} from \"@mdx-js/language-service\"",
        "import { runTsc } from \"@volar/typescript/lib/quickstart/runTsc.js\"",
        "import remarkFrontmatter from \"remark-frontmatter\"",
        "import remarkGfm from \"remark-gfm\"",
        "import ts from \"typescript\"",
        "",
        "const require = createRequire(import.meta.url)",
        "",
        "runTsc(require.resolve(\"typescript/lib/tsc\"), [\".mdx\"], (_, { options }) => {",
        "  const configPath =",
        "    typeof options.configFilePath === \"string\"",
        "      ? options.configFilePath",
        "      : undefined",
        "  const mdx = configPath",
        "    ? ts.readConfigFile(configPath, ts.sys.readFile).config?.mdx",
        "    : undefined",
        "  const fromConfig = createRequire(configPath ?? import.meta.filename)",
        "  const [remarkPlugins, virtualCodePlugins] = resolvePlugins(",
        "    mdx,",
        "    (name) => fromConfig(name).default",
        "  )",
        "  return [",
        "    createMdxLanguagePlugin(",
        "      remarkPlugins ?? [[remarkFrontmatter, [\"toml\", \"yaml\"]], remarkGfm],",
        "      virtualCodePlugins,",
        "      Boolean(mdx?.checkMdx),",
        "      options.jsxImportSource ?? \"react\"",
        "    ),",
        "  ]",
        "})"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "tsconfig.mdx.json",
      "content": [
        "{",
        "  \"extends\": \"./tsconfig.app.json\",",
        "  \"compilerOptions\": {",
        "    \"tsBuildInfoFile\": \"./node_modules/.tmp/tsconfig.mdx.tsbuildinfo\"",
        "  },",
        "  \"mdx\": {",
        "    \"checkMdx\": true,",
        "    \"plugins\": [",
        "      [\"remark-frontmatter\", [\"toml\", \"yaml\"]],",
        "      \"remark-gfm\",",
        "      \"remark-mdx-frontmatter\"",
        "    ]",
        "  },",
        "  \"include\": [\"**/*.mdx\", \"mdx-env.d.ts\"]",
        "}"
      ],
      "mode": 420
    }
  ]
