# Environment variables
.env

# Project skills (Claude Code)
# Rebuilt by the sync-claude-skills hook.
.claude/skills/

# Personal overrides (mise)
mise.local.toml

# Dependencies (Node.js)
node_modules/

# Lockfile (pnpm)
# Regenerated by the pnpm-install hook.
pnpm-lock.yaml

# Compiled files (Python)
__pycache__/

# Virtual environment (Python)
.venv/

# Export output (scripts/export.ts)
/.tmp/

# Build info files (TypeScript)
*.tsbuildinfo

# Output directory (Vite)
dist/
