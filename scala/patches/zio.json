{
  "title": "ZIO application",
  "description": "Replaces the hello-world entry point with a ZIO 2.1 ZIOAppDefault and adds the zio library to build.sbt.",
  "depends_on": [
    "sbt"
  ],
  "when": "use_zio",
  "ops": [
    {
      "op": "delete_file",
      "path": "src/main/scala/Main.scala"
    },
    {
      "op": "modify_file",
      "path": "build.sbt",
      "hunks": [
        {
          "context_before": [
            [
              "version := \"",
              {
                "answer": "project_version"
              },
              "\""
            ],
            [
              "organization := \"",
              {
                "answer": "project_organization"
              },
              "\""
            ]
          ],
          "removed": [],
          "added": [
            "",
            "libraryDependencies += \"dev.zio\" %% \"zio\" % \"2.1.26\""
          ],
          "context_after": []
        }
      ]
    },
    {
      "op": "create_file",
      "path": "src/main/scala/MainApp.scala",
      "content": [
        "import java.io.IOException",
        "",
        "import zio._",
        "",
        "object MainApp extends ZIOAppDefault {",
        "  def run: IO[IOException, Unit] =",
        "    Console.printLine(\"Hello, World!\")",
        "}"
      ],
      "mode": 420
    }
  ]
}
