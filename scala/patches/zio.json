{
  "title": "ZIO application",
  "description": "Replaces the sbt hello-world entry point with a ZIOAppDefault that prints through the ZIO Console.",
  "depends_on": [
    "sbt"
  ],
  "when": "use_zio",
  "ops": [
    {
      "op": "delete_file",
      "path": "src/main/scala/Main.scala"
    },
    {
      "op": "create_file",
      "path": "src/main/scala/MainApp.scala",
      "content": [
        "import java.io.IOException",
        "",
        "import zio._",
        "",
        "object MainApp extends ZIOAppDefault {",
        "  def run: IO[IOException, Unit] =",
        "    Console.printLine(\"Hello, World!\")",
        "}"
      ],
      "mode": 420
    }
  ]
}
