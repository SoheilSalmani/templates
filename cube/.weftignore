# Environment variables
.env

# SQL snapshots (.mise/tasks/check)
# Written in each project's own SQL dialect.
tests/queries/*.sql

# Project skills (Claude Code)
# Rebuilt by the sync-claude-skills hook.
.claude/skills/

# Data directory (Cube Store)
.cubestore/

# Documentation (helm-docs)
# The chart-docs hook generates it from values.yaml.
charts/cube/README.md

# Personal overrides (mise)
mise.local.toml

# Dependencies (Node.js)
node_modules/

# Compiled files (Python)
__pycache__/
