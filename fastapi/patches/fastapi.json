{
  "title": "FastAPI application",
  "description": "Adds a uv-managed FastAPI project on Python 3.13 with a main.py exposing three example routes on top of base, whose README the project keeps. The Python stanzas go at the top of base's .gitignore, and the uv-sync hook runs before base's git-commit.",
  "depends_on": [
    "base"
  ],
  "ops": [
    {
      "op": "modify_file",
      "path": ".gitignore",
      "hunks": [
        {
          "context_before": [],
          "removed": [],
          "added": [
            "# Cache folders (Python)",
            "__pycache__/",
            "",
            "# Virtual environments (Python)",
            ".venv/",
            "",
            "# Configuration and data (Rope)",
            ".ropeproject/",
            ""
          ],
          "context_after": [
            "# Operating system",
            ".DS_Store"
          ]
        }
      ]
    },
    {
      "op": "create_file",
      "path": ".python-version",
      "content": [
        "3.13"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "main.py",
      "content": [
        "from fastapi import FastAPI",
        "from pydantic import BaseModel",
        "",
        "app = FastAPI()",
        "",
        "",
        "class Item(BaseModel):",
        "    name: str",
        "    price: float",
        "    is_offer: bool | None = None",
        "",
        "",
        "@app.get(\"/\")",
        "def read_root():",
        "    return {\"Hello\": \"World\"}",
        "",
        "",
        "@app.get(\"/items/{item_id}\")",
        "def read_item(item_id: int, q: str | None = None):",
        "    return {\"item_id\": item_id, \"q\": q}",
        "",
        "",
        "@app.put(\"/items/{item_id}\")",
        "def update_item(item_id: int, item: Item):",
        "    return {\"item_name\": item.name, \"item_id\": item_id}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "pyproject.toml",
      "content": [
        "[project]",
        [
          "name = \"",
          {
            "answer": "package_name"
          },
          "\""
        ],
        "version = \"0.1.0\"",
        "description = \"Add your description here\"",
        "readme = \"README.md\"",
        "requires-python = \">=3.13\"",
        "dependencies = [",
        "    \"fastapi[standard]>=0.139.2\",",
        "    \"pydantic>=2.13.4\",",
        "]"
      ],
      "mode": 420
    }
  ],
  "hooks": [
    {
      "id": "verify-uv",
      "phase": "pre",
      "effect": "check",
      "label": "Verify uv is installed",
      "action": "command -v uv"
    },
    {
      "id": "uv-sync",
      "phase": "post",
      "effect": "setup",
      "label": "Lock and sync the Python environment",
      "action": "uv lock && uv sync",
      "after": [
        "mise-install"
      ],
      "before": [
        "git-commit"
      ],
      "inputs": [
        "glob:pyproject.toml"
      ]
    }
  ]
}
