{
  "title": "Gradle build (Kotlin DSL)",
  "depends_on": [
    "base"
  ],
  "ops": [
    {
      "op": "create_file",
      "path": ".gitignore",
      "content": [
        ".gradle/",
        "build/",
        ".idea/",
        "*.iml",
        "*.class",
        "",
        "# Keep the Gradle wrapper jar in version control.",
        "!gradle/wrapper/gradle-wrapper.jar",
        "",
        "# Operating system",
        ".DS_Store",
        "Thumbs.db",
        "",
        "# Environment files",
        ".env",
        ".env.*",
        "!.env.example",
        "",
        "# Personal toolchain overrides (mise)",
        "mise.local.toml",
        "",
        "# Personal settings (Claude Code)",
        ".claude/settings.local.json"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "README.md",
      "content": [
        [
          "# ",
          {
            "answer": "project_name"
          }
        ],
        "",
        "A Java 25 application built with Gradle."
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "build.gradle.kts",
      "content": [
        "plugins {",
        "    java",
        "    application",
        "}",
        "",
        "group = \"com.example\"",
        "version = \"0.1.0\"",
        "",
        "java {",
        "    toolchain {",
        "        languageVersion = JavaLanguageVersion.of(25)",
        "    }",
        "}",
        "",
        "application {",
        "    mainClass = \"App\"",
        "}",
        "",
        "repositories {",
        "    mavenCentral()",
        "}",
        "",
        "dependencies {",
        "}"
      ],
      "mode": 420
    },
    {
      "op": "create_file",
      "path": "settings.gradle.kts",
      "content": [
        [
          "rootProject.name = \"",
          {
            "answer": "app_slug"
          },
          "\""
        ]
      ],
      "mode": 420
    }
  ]
}
